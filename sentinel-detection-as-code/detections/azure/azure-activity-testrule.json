
{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "string"
    }
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "apiVersion": "2022-11-01",
      "name": "[concat(parameters('workspace'), '/Microsoft.SecurityInsights/6de3e16a-a15c-45fa-9035-9dd7149bb637')]",
      "kind": "Scheduled",
      "properties": {
        "displayName": "[LAB] Azure Resource Group Deletion",
        "description": "Detects successful resource group deletion operations.",
        "severity": "Medium",
        "enabled": false,
        "query": "AzureActivity | where TimeGenerated > ago(1h) | where OperationNameValue =~ 'Microsoft.Resources/subscriptions/resourcegroups/delete' | where ActivityStatusValue =~ 'Success' | project TimeGenerated, Caller, ResourceGroup, OperationNameValue",
        "queryFrequency": "PT1H",
        "queryPeriod": "PT1H",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionEnabled": false,
        "suppressionDuration": "PT1H",
        "tactics": [
          "Impact"
        ],
        "techniques": [
          "T1485"
        ]
      }
    }
  ]
}
